# Entorno virtual y archivos generados
/BigData20262/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
/.venv/
/venv/

# Compilados de C# (se regeneran con dotnet build)
/benchmark_csharp/bin/
/benchmark_csharp/obj/

# Datos crudos y derivados (se descargan/regeneran al ejecutar los notebooks)
# Bronze: se ignoran los datos pesados en cualquier subcarpeta,
# pero se conservan los manifiestos (trazabilidad: origen, tamaño, sha256)
/data/bronze/**/*.csv
/data/bronze/**/*.zip
/data/bronze/**/*.parquet
/data/silver/*
!/data/silver/text.txt
/data/gold/*
!/data/gold/text.txt

# Salidas generadas por los notebooks (gráficos, reportes)
/outputs/*
!/outputs/text.txt

# Temporales
/tmp/*
!/tmp/text.txt
